# Credentials
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Model Configuration
# NVIDIA NIM models (discover NVIDIA_NIM_MODEL1, NVIDIA_NIM_MODEL2, etc.)
NVIDIA_NIM_MODEL1=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_MODEL2=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_MODEL3=poolside/laguna-xs-2.1

# Legacy support (optional)
# NVIDIA_NIM_MODEL=

# Other models
# OpenRouter is intentionally restricted to free routing/models.
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_MODEL1=openrouter/free
# OPENROUTER_MODEL2=provider/model:free
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_MODEL=qwen2.5:7b
GROQ_MODEL1=openai/gpt-oss-120b
GROQ_MODEL2=openai/gpt-oss-20b
GEMINI_MODEL1=gemini-3.8-flash
# Confirm the current free-tier model ID in the Cerebras dashboard.
CEREBRAS_MODEL1=
CLOUDFLARE_MODEL1=@cf/openai/gpt-oss-120b

# Local Endpoints
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# Derived from CLOUDFLARE_ACCOUNT_ID when omitted:
# CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account-id>/ai/v1

# Routing (logical models -> provider chain)
ROUTER_OPUS=nvidia_nim,groq,gemini,open_router,cloudflare,cerebras,ollama
ROUTER_SONNET=nvidia_nim,groq,gemini,open_router,cloudflare,cerebras,ollama
ROUTER_HAIKU=groq,gemini,open_router,cloudflare,cerebras,ollama

# Suggested free-first routes after filling the corresponding credentials:
# ROUTER_OPUS=nvidia_nim,groq,gemini,open_router,cloudflare,cerebras,ollama
# ROUTER_SONNET=nvidia_nim,groq,gemini,open_router,cloudflare,cerebras,ollama
# ROUTER_HAIKU=groq,gemini,open_router,cloudflare,cerebras,ollama

# Performance and Tools
TOOL_ALLOWLIST=Read,Edit,Write,Bash,Glob,Grep
ENABLE_THINKING=false
HTTP_READ_TIMEOUT=600
PROVIDER_MAX_CONCURRENCY=5